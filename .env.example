# Supabase (server-side bot: use service_role key when RLS is on)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_DB_PASSWORD=your_db_password

# Default chain key from lib/chains.js
DEFAULT_CHAIN=giwa_sepolia

# GIWA Sepolia (also used as chain registry overrides)
GIWA_RPC=https://sepolia-rpc.giwa.io
GIWA_CHAIN_ID=91342
GIWA_EXPLORER=https://sepolia-explorer.giwa.io

# Flizy DEX (GIWA Sepolia). Defaults match deployments/giwa-sepolia.json
# CHAIN_GIWA_SEPOLIA_WETH=0x3a13399f2741122B63c7710B2A85346B97C6BFDf
# CHAIN_GIWA_SEPOLIA_DEX_ROUTER=0x4055413A4757e069bbCAc481639EF2814224Faa0
# CHAIN_GIWA_SEPOLIA_DEX_FACTORY=0xBB1d2c582E455B448660A199097A54DF29162BbF
# CHAIN_GIWA_SEPOLIA_FEE_ROUTER=0x6427fD0c13577847888B7E2d1A24C887bBEBd9cC
# CHAIN_GIWA_SEPOLIA_FLZ=0x308be8f71DA695f18E70D2243a446e1fD1566BA6
# CHAIN_GIWA_SEPOLIA_FLZ_WETH_PAIR=0xEC6Ebf4A7a3088EB22535C9F767B9Ab5845D8227
# FLIZY_TREASURY=0x81Fb7Ed21B9843D2D5C232A7F3e959F91993401B
# SWAP_FEE_BPS=30
# SWAP_SLIPPAGE_BPS=100

# Agent wallet derivation secret (REQUIRED). Min 32 chars.
# Every per-account agent wallet key is HMAC(this secret, account id). Without it
# the account id alone would be the key, and that id is an internal identifier
# rather than a secret.
# Must be the SAME value on the VPS and on Vercel or an account resolves to a
# different address in chat than on the site.
# Changing it changes every agent wallet address: sweep funds first with
# scripts/sweep-agent-wallets.js. Never commit a real value.
WALLET_DERIVATION_SECRET=your_long_random_secret_min_32_chars

# Ops wallet (gas / infra only — never user claim escrow)
PRIVATE_KEY=0xyour_testnet_private_key

# Claim escrow wallet (separate key; holds pending phone claims only).
# If unset, a derived address is used (different from ops) for testnet.
# Set an explicit key before any mainnet-adjacent use.
# ESCROW_PRIVATE_KEY=0xyour_escrow_only_private_key

MAX_SEND_ETH=0.1
# 0 = no default daily cap (account can still set one on the site)
DEFAULT_DAILY_SEND_LIMIT_ETH=0
GAS_BUFFER_ETH=0.0001

# Admins: WhatsApp sender ids (digits), comma separated.
# This is the sender id, which on most accounts is a LID and NOT the phone
# number. Send the me command from the chat you want to promote and copy the id
# it prints back. A phone number here only works if that account still reports
# its number as the sender id.
# ADMIN_PHONES=100000000000000,100000000000001

ADMIN_SETUP_SECRET=change-this-to-a-long-random-string

# Bot WhatsApp number (digits only, no +). Used for dashboard deep links only.
# Do not publish this on public pages (keep NEXT_PUBLIC_SHOW_BOT_NUMBER=false).
BOT_WHATSAPP_NUMBER=your_country_code_and_number_digits

# Telegram client (node telegram.js). Token from @BotFather.
# Never commit a real token. Only one process may poll a token at a time.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Bot username without @, used for t.me/<username>?start=CODE deep links on the site.
TELEGRAM_BOT_USERNAME=your_bot_username
# Long poll wait in seconds
TELEGRAM_POLL_TIMEOUT_SEC=30

# How often a client drains notifications queued for its own channel (ms).
# Only used when the notifying process cannot deliver on that channel itself.
OUTBOX_DRAIN_MS=5000

# Site base URL. Production:
SITE_URL=https://flizy.app
NEXT_PUBLIC_SITE_URL=https://flizy.app
NEXT_PUBLIC_SHOW_BOT_NUMBER=false

# Low-detail rejection when destination is not trusted (tunable)
REJECT_UNTRUSTED_COPY=That destination is not allowed. Manage trusted addresses on the Flizy site. See site docs for details.

LINK_CODE_TTL_MS=600000
SESSION_TTL_MS=3600000

REQUIRE_FLIZY_PREFIX=true
ENFORCE_TRUSTED=true
# false = anyone can send without admin credit (recommended)
ENFORCE_CREDIT=false
# false = no PIN unlock barrier for early self-serve
REQUIRE_UNLOCK=false

# Optional extra ERC-20 list for flizy balance / dashboard holdings (FLZ is auto-tracked)
# TRACKED_TOKENS=0xToken:SYMBOL:18,0xUsdc:USDC:6

# Optional Chrome path if auto-detect fails
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
