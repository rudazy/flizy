# Supabase (server-side bot: use service_role key when RLS is on)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_DB_PASSWORD=your_db_password

# Default chain key from lib/chains.js
DEFAULT_CHAIN=giwa_sepolia

# GIWA Sepolia (also used as chain registry overrides)
GIWA_RPC=https://sepolia-rpc.giwa.io
GIWA_CHAIN_ID=91342
GIWA_EXPLORER=https://sepolia-explorer.giwa.io

# Optional per-chain DEX placeholders (Phase 5)
# CHAIN_GIWA_SEPOLIA_WETH=
# CHAIN_GIWA_SEPOLIA_DEX_ROUTER=
# CHAIN_GIWA_SEPOLIA_DEX_FACTORY=

# Ops wallet (gas / infra only — never user claim escrow)
PRIVATE_KEY=0xyour_testnet_private_key

# Claim escrow wallet (separate key; holds pending phone claims only).
# If unset, a derived address is used (different from ops) for testnet.
# Set an explicit key before any mainnet-adjacent use.
# ESCROW_PRIVATE_KEY=0xyour_escrow_only_private_key

MAX_SEND_ETH=0.1
# 0 = no default daily cap (account can still set one on the site)
DEFAULT_DAILY_SEND_LIMIT_ETH=0
GAS_BUFFER_ETH=0.0001

# Admins: WhatsApp sender ids (digits). Use the me command.
# ADMIN_PHONES=193767785128020

ADMIN_SETUP_SECRET=change-this-to-a-long-random-string

# Bot WhatsApp number (digits only, no +). Used for dashboard deep links only.
# Do not publish this on public pages (keep NEXT_PUBLIC_SHOW_BOT_NUMBER=false).
BOT_WHATSAPP_NUMBER=your_country_code_and_number_digits

# Site base URL. Production:
SITE_URL=https://flizy.vercel.app
NEXT_PUBLIC_SITE_URL=https://flizy.vercel.app
NEXT_PUBLIC_SHOW_BOT_NUMBER=false

# Low-detail rejection when destination is not trusted (tunable)
REJECT_UNTRUSTED_COPY=That destination is not allowed. Manage trusted addresses on the Flizy site. See site docs for details.

LINK_CODE_TTL_MS=600000
SESSION_TTL_MS=3600000

REQUIRE_FLIZY_PREFIX=true
ENFORCE_TRUSTED=true
# false = anyone can send without admin credit (recommended)
ENFORCE_CREDIT=false
# false = no PIN unlock barrier for early self-serve
REQUIRE_UNLOCK=false

# Optional ERC-20 list for flizy balance / dashboard holdings
# TRACKED_TOKENS=0xToken:SYMBOL:18,0xUsdc:USDC:6

# Optional Chrome path if auto-detect fails
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
