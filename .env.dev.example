# Flizy DEV / staging environment. Template only - never put real values here.
#
# Copy to .env.dev (gitignored) and fill in. .env.dev is the ONLY file the dev
# tooling reads. Production values live in web/.env.local and must never be
# copied into this file or any other dev file.
#
# Loaded by:
#   node scripts/run-dev-migrations.js   (schema, dev database only)
#   node --env-file=.env.dev index.js    (bot against dev, once filled)

# ---------------------------------------------------------------------------
# Dev database guard. Required.
#
# The project ref of the DEV Supabase project, i.e. the <ref> in
# https://<ref>.supabase.co. The migration runner derives the ref from
# SUPABASE_URL and refuses to connect unless it matches this value exactly.
# Two independent places must both say "dev" before any SQL runs, so a
# production URL pasted into SUPABASE_URL by mistake aborts instead of
# migrating the live database.
# ---------------------------------------------------------------------------
DEV_SUPABASE_REF=your_dev_project_ref

# ---------------------------------------------------------------------------
# Dev Supabase. Required to boot.
# SUPABASE_KEY is the service_role key: server-side only, never in client code,
# never committed. The app makes no browser-side Supabase calls, so the anon
# key is not needed to run (see notes at the bottom).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your_dev_project_ref.supabase.co
SUPABASE_KEY=your_dev_service_role_key
SUPABASE_DB_PASSWORD=your_dev_db_password

# ---------------------------------------------------------------------------
# Connection route for the dev tooling. Optional.
#
# By default the dev scripts connect straight to db.<ref>.supabase.co on 5432.
# On some networks that name resolves IPv6-only and the connection times out
# with ETIMEDOUT, while HTTPS to the same project works fine. Setting the
# pooler host below switches to Supabase's IPv4-reachable pooler instead.
#
# This does not widen the dev guard. The tooling builds the username itself as
# postgres.<ref>, using the ref that already passed the SUPABASE_URL vs
# DEV_SUPABASE_REF check, and Supabase routes a pooler connection by that
# username. Changing the host changes the region, never the project. The host
# must also be a *.pooler.supabase.com name.
#
# Leave unset to use the direct host. Port defaults to 5432 (session mode),
# which is what multi-statement DDL in a transaction needs; do not use 6543.
# ---------------------------------------------------------------------------
# SUPABASE_DB_POOLER_HOST=aws-0-eu-west-1.pooler.supabase.com
# SUPABASE_DB_POOLER_PORT=5432

# ---------------------------------------------------------------------------
# Chain. Dev can reuse the production values: GIWA Sepolia is a public testnet
# and these are not secrets.
# ---------------------------------------------------------------------------
DEFAULT_CHAIN=giwa_sepolia
GIWA_RPC=https://sepolia-rpc.giwa.io
GIWA_CHAIN_ID=91342
GIWA_EXPLORER=https://sepolia-explorer.giwa.io

# ---------------------------------------------------------------------------
# Wallet keys. Required to boot.
#
# Use a FRESH dev-only key, not the production ops key. A dev key that shares
# an address with production would let a dev mistake move production funds.
# Fund the dev address with GIWA Sepolia testnet ETH only.
# ---------------------------------------------------------------------------
PRIVATE_KEY=0xyour_dev_only_testnet_private_key
# Optional. Separate escrow key; falls back to a derived address if unset.
# ESCROW_PRIVATE_KEY=0xyour_dev_only_escrow_key

# ---------------------------------------------------------------------------
# Agent wallet derivation secret. Required to boot. Min 32 chars.
#
# Use a FRESH dev secret. Reusing the production secret would make dev derive
# the exact same per-account agent wallet addresses as production, so a dev
# test could sweep or spend against real production addresses.
# ---------------------------------------------------------------------------
WALLET_DERIVATION_SECRET=fresh_dev_only_random_secret_min_32_chars

# ---------------------------------------------------------------------------
# OAuth state signing. Required for any identity linking flow. Min 32 chars.
# Fresh dev value; deliberately not the same as WALLET_DERIVATION_SECRET.
# ---------------------------------------------------------------------------
OAUTH_STATE_SECRET=fresh_dev_only_random_secret_min_32_chars

# ---------------------------------------------------------------------------
# OAuth apps. Dev needs its OWN apps, because the callback URL is registered
# per app and must match the dev site origin character for character:
#   <SITE_URL>/api/auth/github/callback
# Pointing dev at the production OAuth app would send dev callbacks to the
# production domain. Leave blank to skip that linking flow in dev.
# ---------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# Optional read-only tokens for handle resolution
# GITHUB_API_TOKEN=
# X_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Bot clients. Dev needs a SEPARATE Telegram bot: only one process may poll a
# given token at a time, so reusing the production token would fight with the
# production bot for updates and silently steal user messages.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLL_TIMEOUT_SEC=30
BOT_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Email delivery. Leave unset in dev to keep verification codes out of real
# inboxes; the code path logs instead of sending when unconfigured.
# ---------------------------------------------------------------------------
# EMAIL_FROM=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_CODE_SECRET=

# ---------------------------------------------------------------------------
# Site URLs. Must point at the dev deployment, never flizy.app.
# ---------------------------------------------------------------------------
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_BOT_NUMBER=false
NEXT_PUBLIC_BOT_WHATSAPP_NUMBER=

# ---------------------------------------------------------------------------
# Admin / behaviour flags. Fresh dev secret for the promote path.
# ---------------------------------------------------------------------------
ADMIN_SETUP_SECRET=fresh_dev_only_random_string
# ADMIN_PHONES=
MAX_SEND_ETH=0.1
DEFAULT_DAILY_SEND_LIMIT_ETH=0
GAS_BUFFER_ETH=0.0001
LINK_CODE_TTL_MS=600000
SESSION_TTL_MS=3600000
REQUIRE_FLIZY_PREFIX=true
ENFORCE_TRUSTED=true
ENFORCE_CREDIT=false
REQUIRE_UNLOCK=false
OUTBOX_DRAIN_MS=5000
REJECT_UNTRUSTED_COPY=That destination is not allowed. Manage trusted addresses on the Flizy site. See site docs for details.

# ---------------------------------------------------------------------------
# Analytics: intentionally omitted. GA and Clarity are production-only and the
# web code already refuses to load them outside production. Setting them here
# would pollute production analytics with dev traffic.
#
# Supabase anon key: intentionally omitted. Nothing in this codebase reads an
# anon key - every Supabase call is server-side with the service_role key, and
# there is no NEXT_PUBLIC_SUPABASE_* variable anywhere. Keep the dev anon key
# on file in Supabase, but it is not required for dev to run.
# ---------------------------------------------------------------------------
